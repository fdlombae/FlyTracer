#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

// A raytracer written in PGA with flyfish.glsl: the camera is a motor, rays are points with
// directions, triangles are tested with the Plücker products of their edges, reflections are
// sandwiches with planes. Whitted-style: at every hit, direct light from all lights with shadow
// rays, then a chain of mirror or glossy reflections. Every frame adds one jittered sample per pixel
// to a running average, which anti-aliases edges and smooths glossy reflections while the view stays
// the same.

#include "flyfish.glsl"
#include "common.glsl"
#include "ray.glsl"
#include "bindings.glsl"
#include "random.glsl"
#include "intersections.glsl"
#include "traversal.glsl"
#include "brdf.glsl"
#include "shading.glsl"
#include "output.glsl"
#include "debug_lines.glsl"

layout(local_size_x = WORKGROUP_SIZE, local_size_y = WORKGROUP_SIZE) in;

// The ray through a point of the image plane, in pixels from the top left. In the camera's own
// frame it starts at the origin and runs down -z; the camera motor moves it into the world.
Ray cameraRay(vec2 pixel, vec2 imageSize) {
    vec2 ndc = 2.0 * pixel / imageSize - 1.0;
    float aspect = imageSize.x / imageSize.y;
    Motor camera = Motor(pc.cameraRotor.x, pc.cameraRotor.yzw, pc.cameraDual.xyz, pc.cameraDual.w);
    TriVector towards = direction(vec3(ndc.x * aspect * pc.tanHalfFov, -ndc.y * pc.tanHalfFov, -1.0));
    return Ray(sandwich(camera, point(vec3(0.0))), normalized(sandwich(camera, towards)));
}

// Radiance arriving along the ray. firstHitDistance is INFINITY when the ray sees the sky.
vec3 traceRadiance(Ray ray, float pixelAngle, inout uint rng, out float firstHitDistance) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float travelled = 0.0;
    firstHitDistance = INFINITY;

    for (uint bounce = 0u; bounce < pc.maxBounces; ++bounce) {
        Hit hit = traceScene(ray, INFINITY, false);
        if (hit.type == HIT_NONE) {
            radiance += throughput * skyColor(ray.direction.xyz);
            break;
        }
        if (bounce == 0u) {
            firstHitDistance = hit.t;
        }
        travelled += hit.t;

        Surface surface = surfaceAt(hit, ray, pixelAngle * travelled);
        TriVector V = direction(-ray.direction.xyz);
        radiance += throughput * shade(surface, V);

        TriVector reflected;
        throughput *= sampleReflection(surface, V, rng, reflected);
        if (max(throughput.r, max(throughput.g, throughput.b)) < 0.01) break;
        ray = Ray(point(offsetRayOrigin(surface.position.xyz, surface.geometricNormal.xyz)), reflected);
    }
    return radiance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    // The first sample goes through the pixel center, later ones are spread over the pixel
    uint rng = seedRandom(pixel, pc.frameIndex);
    vec2 jitter = pc.sampleIndex == 0u ? vec2(0.5) : vec2(random(rng), random(rng));
    float pixelAngle = 2.0 * pc.tanHalfFov / float(size.y);

    float hitDistance;
    vec3 radiance = traceRadiance(cameraRay(vec2(pixel) + jitter, vec2(size)), pixelAngle, rng, hitDistance);

    // Running average of all samples since the view or scene last changed
    vec3 average = radiance;
    if (pc.sampleIndex > 0u) {
        vec3 previous = imageLoad(accumulationImage, pixel).rgb;
        average = previous + (radiance - previous) / float(pc.sampleIndex + 1u);
    }
    imageStore(accumulationImage, pixel, vec4(average, 1.0));

    vec3 color = toneMapACES(average * pc.exposure);
    color = drawDebugLines(cameraRay(vec2(pixel) + 0.5, vec2(size)), hitDistance, pixelAngle, color);
    imageStore(outputImage, pixel, vec4(linearToSrgb(color), 1.0));
}
